# Caddy: HTTPS, the website, media files (with range requests) and the API.
# SITE_ADDRESS comes from .env:
#   :80                          LAN only, plain HTTP (http://<server-ip>/)
#   materi.example.com, :80      public domain with automatic HTTPS, plus plain HTTP on the LAN
{
	admin off
	servers {
		# Percayai alamat pengunjung asli (X-Forwarded-For) hanya dari "pintu depan" yang kita kenal:
		# VPS manggalasatya60.com & Tailscale Funnel (jaringan Tailscale 100.64.0.0/10) dan Docker/localhost.
		# Pengguna WiFi kampus (10.x) tidak dipercaya, jadi tidak bisa memalsukan alamatnya.
		trusted_proxies static 127.0.0.1/8 ::1 172.16.0.0/12 100.64.0.0/10 fd7a:115c:a1e0::/48
	}
}

(site) {
	# Header keamanan untuk semua halaman
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		?Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy app:3000
	}

	handle /config.js {
		header Content-Type "application/javascript"
		header Cache-Control "no-cache"
		# Versi GitHub Pages / Railway memeriksa file ini untuk tahu server sedang menyala
		header Access-Control-Allow-Origin "*"
		respond "window.AKPOL_SERVER = true;" 200
	}

	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=86400"
		@files path /files/*
		header @files Cache-Control "public, max-age=3600"
		@dl query dl=1
		header @dl Content-Disposition "attachment"
		@m3u8 path *.m3u8
		header @m3u8 Content-Type "application/vnd.apple.mpegurl"
		@ts path *.ts
		header @ts Content-Type "video/mp2t"
		# File yang bisa menjalankan script (HTML, SVG, ...) tidak pernah dibuka sebagai halaman web situs ini
		@active path_regexp active (?i)\.(html?|xhtml|shtml|svgz?|xml|xsl|js|mjs)$
		header @active Content-Disposition "attachment"
		header @active Content-Security-Policy "sandbox; frame-ancestors 'self'; object-src 'none'"
		file_server
	}

	handle /vendor/* {
		root * /srv/site
		header Cache-Control "public, max-age=604800"
		@mjs path *.mjs
		header @mjs Content-Type "text/javascript"
		file_server
	}

	handle /assets/* {
		root * /srv/site
		header Cache-Control "public, max-age=86400"
		file_server
	}

	@index path / /index.html
	handle @index {
		root * /srv/site
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	handle {
		respond "Tidak ditemukan" 404
	}

	encode {
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/vnd.apple.mpegurl*
		}
	}
	log {
		output stdout
		format console
		level ERROR
	}
}

{$SITE_ADDRESS::80} {
	import site
}
