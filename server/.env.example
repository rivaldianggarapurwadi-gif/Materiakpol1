# Salin file ini menjadi .env lalu sesuaikan.  cp .env.example .env

# Alamat web.
#   :80                              hanya jaringan lokal (buka http://<IP-server>/)
#   materi.domainmu.com, :80         domain publik dengan HTTPS otomatis + tetap bisa dibuka lewat IP lokal
SITE_ADDRESS=:80

# Folder penyimpanan semua materi, database, dan cadangan.
# Sebaiknya di harddisk besar, mis. /mnt/materi/data
DATA_DIR=./data

# Admin pertama (dibuat sekali saat server pertama kali jalan). Hapus kata sandinya dari file ini setelah itu.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Ukuran maksimum satu file upload (GB)
MAX_UPLOAD_GB=50

# Encoder video: auto (pakai GPU kalau ada) | libx264 | h264_vaapi | h264_qsv | h264_nvenc
VIDEO_ENCODER=auto

# File yang dihapus disimpan di sampah selama ... hari
TRASH_DAYS=30

# Peringatan disk hampir penuh jika sisa kurang dari ... GB
LOW_DISK_GB=10
